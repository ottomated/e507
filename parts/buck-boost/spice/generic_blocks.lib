+  VSS=0 VTHRESH=0.5
X_U23         VIN N16794468 INV_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
X_U4         RAMP_1 IN_OUT_1 OUT2 COMP_BASIC_GEN PARAMS: VDD=1 VSS=0
+  VTHRESH=0.5
C_C3         RAMP_1 0  100p IC=0 
C_C2         RAMP 0  100p IC=0 
