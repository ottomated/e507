X_U2         CLK N16698680 BUF_DELAY_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=0.5
+  DELAY={CLK_WIDTH}
X_U131         RAMP VREF_OSC CLK COMP_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=0.5
D_D11         RAMP N16699162 D_Dosc 
V_V45         N16699162 0 {Vosc+4}
G_ABMI3         N16699162 RAMP VALUE { {Cosc*Vosc/V(Time_Period)}    }
X_U134         SDWN N16698680 DISCH OR2_BASIC_GEN PARAMS: VDD=1 VSS=0
+  VTHRESH=500E-3
.model D_Dosc d
